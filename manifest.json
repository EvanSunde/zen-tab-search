{
  "manifest_version": 2,
  "name": "Zen Glass",
  "version": "1.2.0",
  "description": "A lightweight frosted-glass palette for tabs, bookmarks, windows and Zen workspaces.",
  "permissions": [
    "tabs",
    "activeTab",
    "bookmarks",
    "contextualIdentities",
    "storage",
    "sessions"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Zen Glass",
    "default_popup": "panel.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open Zen Glass"
    }
  },
  "web_accessible_resources": [
    "panel.html",
    "panel.css",
    "panel.js",
    "search.js"
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none';",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-glass@local",
      "strict_min_version": "140.0"
    }
  },
  "experiment_apis": {
    "zenGlass": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "zenGlass"
          ]
        ],
        "script": "experiments/api.js"
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
